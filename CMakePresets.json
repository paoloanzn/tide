{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug (vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      },
      "environment": { "VCPKG_FORCE_SYSTEM_BINARIES": "1" }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release (vcpkg)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "lint",
      "inherits": "default",
      "displayName": "Debug + clang-tidy, warnings as errors",
      "binaryDir": "${sourceDir}/build/lint",
      "cacheVariables": { "TIDE_WERROR": "ON", "TIDE_CLANG_TIDY": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" },
    { "name": "lint", "configurePreset": "lint" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } }
  ]
}
