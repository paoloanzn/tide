# Strict lint profile for Tide. Every check family is on; the exclusions below
# are deliberate and each one is explained.
#
#   readability-identifier-length         Short names (e, v, i) are idiomatic in
#                                         the small scopes where they are used.
#   modernize-use-trailing-return-type    Style only; the codebase uses leading
#                                         return types.
#   readability-braces-around-statements  Single-statement bodies stay brace-less;
#   google-readability-braces-around-...  clang-format fixes their indentation and
#                                         -Wmisleading-indentation catches the
#                                         hazard the check guards against.
#   readability-magic-numbers             Byte layouts, offsets and sizes come
#   cppcoreguidelines-avoid-magic-numbers from the Solana wire formats.
#   misc-no-recursion                     The checker and interpreter walk a
#                                         recursive AST; recursion is the design.
#   cppcoreguidelines-avoid-const-or-     Reference members (Diagnostics&,
#     ref-data-members                    std::ostream&) are intended non-owning,
#                                         non-reassignable collaborators.
#   modernize-return-braced-init-list     `return Value(x)` names the variant type
#                                         being produced; `return {x}` hides it.
#   google-readability-todo               No TODO(username) convention.
#   clang-analyzer-optin.core.            Reports ORed values of bit-flag enums as
#     EnumCastOutOfRange                  out of range; it fires inside Catch2's
#                                         assertion macros (ResultDisposition).
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -modernize-use-trailing-return-type,
  -readability-braces-around-statements,
  -google-readability-braces-around-statements,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -misc-no-recursion,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -modernize-return-braced-init-list,
  -google-readability-todo,
  -clang-analyzer-optin.core.EnumCastOutOfRange
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(src|tests)/.*'
FormatStyle: file
CheckOptions:
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  readability-implicit-bool-conversion.AllowPointerConditions: true
  readability-function-cognitive-complexity.IgnoreMacros: true
  # Umbrella headers of third-party libraries are included as documented.
  # asm*/ are Linux kernel headers behind POSIX ones (SO_REUSEADDR comes from
  # <sys/socket.h>); including them directly would break macOS builds.
  misc-include-cleaner.IgnoreHeaders: 'lexy/.*;lexy_ext/.*;nlohmann/.*;catch2/.*;cpr/.*;bits/.*;asm/.*;asm-generic/.*'
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: lower_case
  # A trailing underscore avoids a keyword: TypeKind::int_, BinaryOp::and_.
  readability-identifier-naming.EnumConstantIgnoredRegexp: '^(void|int|float|bool|and|or|not)_$'
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.MethodIgnoredRegexp: '^(void|int|float|bool)_$'
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ConstexprVariableCase: lower_case
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
